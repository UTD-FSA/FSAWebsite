# ── .env.example ───────────────────────────────────────────
# names only, no real values — copy to .env.local and fill in.
# .env.local is gitignored; this file is deliberately exempted (see .gitignore)
# so a fresh checkout knows what it needs.

# ── supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service-role key — bypasses RLS, server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ── site ──────────────────────────────────────────────────
# used to build absolute redirect/success/cancel URLs (Stripe checkout, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# for local webhook testing:
#   stripe login
#   stripe listen --forward-to localhost:3000/api/stripe-webhook
# paste the printed whsec_... below, then restart `npm run dev`.
# do NOT use `stripe trigger` for event-ticket flows — synthetic events carry no
# metadata.pending_id and exercise nothing real. drive the actual register/checkout
# flow in a browser so Stripe emits genuine events. see CLAUDE.md's Payments section.
STRIPE_WEBHOOK_SECRET=

# ── aws s3 (event cover photos / gallery images) ───────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# ── resend (transactional email) ───────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
